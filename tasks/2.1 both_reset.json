{
  "title": "Если a и b произошли одновременно, то в следующий момент оба должны быть ложны.",
  "predicates": [
    "a",
    "b"
  ],
  "formula": "[] ((a && b) -> X (!a && !b))",
  "tests": [
    {
      "name": "start_00",
      "note": "Начальное 00; после совместного события оба ложны.",
      "prefix": [
        { "a": 0, "b": 0 },
        { "a": 1, "b": 1 },
        { "a": 0, "b": 0 }
      ],
      "expected": true
    },
    {
      "name": "start_01",
      "note": "Начальное 01; после совместного события оба ложны.",
      "prefix": [
        { "a": 0, "b": 1 },
        { "a": 1, "b": 1 },
        { "a": 0, "b": 0 }
      ],
      "expected": true
    },
    {
      "name": "start_10",
      "note": "Начальное 10; после совместного события оба ложны.",
      "prefix": [
        { "a": 1, "b": 0 },
        { "a": 1, "b": 1 },
        { "a": 0, "b": 0 }
      ],
      "expected": true
    },
    {
      "name": "start_11",
      "note": "Начальное 11; после совместного события оба ложны.",
      "prefix": [
        { "a": 1, "b": 1 },
        { "a": 0, "b": 0 }
      ],
      "expected": true
    },
    {
      "name": "only_a_resets",
      "note": "Сброшено только a; b осталось истинным.",
      "prefix": [
        { "a": 1, "b": 1 },
        { "a": 0, "b": 1 }
      ],
      "expected": false
    },
    {
      "name": "only_b_resets",
      "note": "Сброшено только b; a осталось истинным.",
      "prefix": [
        { "a": 1, "b": 1 },
        { "a": 1, "b": 0 }
      ],
      "expected": false
    },
    {
      "name": "late_reset",
      "note": "Сброс на шаг позже; повтор 11.",
      "prefix": [
        { "a": 0, "b": 0 },
        { "a": 1, "b": 1 },
        { "a": 1, "b": 1 },
        { "a": 0, "b": 0 }
      ],
      "expected": false
    },
    {
      "name": "later_violation",
      "note": "Первое совместное событие корректно; второе нарушает условие.",
      "prefix": [
        { "a": 1, "b": 1 },
        { "a": 0, "b": 0 },
        { "a": 1, "b": 1 },
        { "a": 1, "b": 0 },
        { "a": 0, "b": 0 }
      ],
      "expected": false
    },
    {
      "name": "never_together",
      "note": "Условие импликации ни разу не выполнено.",
      "prefix": [
        { "a": 0, "b": 0 },
        { "a": 0, "b": 1 },
        { "a": 1, "b": 0 },
        { "a": 0, "b": 0 }
      ],
      "expected": true
    },
    {
      "name": "always_false",
      "note": "Нет событий.",
      "prefix": [
        { "a": 0, "b": 0 }
      ],
      "expected": true
    },
    {
      "name": "always_together",
      "note": "Явный loop повторяет 11 бесконечно.",
      "prefix": [
        { "a": 1, "b": 1 }
      ],
      "loop": [
        { "a": 1, "b": 1 }
      ],
      "expected": false
    },
    {
      "name": "periodic_reset",
      "note": "Каждое совместное событие в цикле сразу сбрасывается.",
      "prefix": [
        { "a": 0, "b": 0 }
      ],
      "loop": [
        { "a": 1, "b": 1 },
        { "a": 0, "b": 0 }
      ],
      "expected": true
    },
    {
      "name": "periodic_bad",
      "note": "В цикле после 11 следует 01.",
      "prefix": [
        { "a": 0, "b": 0 }
      ],
      "loop": [
        { "a": 1, "b": 1 },
        { "a": 0, "b": 1 },
        { "a": 0, "b": 0 }
      ],
      "expected": false
    }
  ]
}
